# ==============================================================================
# PXS E-COMMERCE ENVIRONMENT CONFIGURATION BLUEPRINT (.env.example)
# ==============================================================================
# Copy this file to '.env' in local development:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS:          cp .env.example .env
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit your real '.env' file to Git.
# 2. NEVER put production database passwords or live payment keys in this file.
# 3. Production secrets must be configured directly in your hosting dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Port where Express API listens (Default: 5000)
PORT=5000

# Canonical URL of the client frontend for CORS origin whitelisting
# Development: http://localhost:5173
# Production:  https://pxswear.com
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL - Neon Serverless / Supabase)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection string with SSL mode enabled.
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://pxs_user:your_secure_password@ep-sample-pool-123456.us-east-2.aws.neon.tech/pxs_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (Sessions & Cryptography)
# ------------------------------------------------------------------------------
# Cryptographically strong secret key used to sign session cookies/JWTs.
# Generate a new 64-character hex string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_64_character_cryptographically_secure_random_hex_string

# Duration of session cookies in days (Default: 7)
SESSION_EXPIRES_DAYS=7

# Domain scope for cookies. 
# Development: localhost
# Production:  .pxswear.com
COOKIE_DOMAIN=localhost

# General API rate limiting (Maximum requests allowed per window per IP)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# Sensitive endpoint rate limiting (Login, Signup, Forgot Password)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay Key ID and Secret Key.
# Always use TEST keys ('rzp_test_...') during development and staging.
# NEVER put live keys ('rzp_live_...') in code or commit them.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Secret used to verify Razorpay Webhook HMAC-SHA256 signatures
RAZORPAY_WEBHOOK_SECRET=your_random_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. BUSINESS & STORE RULES (Cash on Delivery & Inventory)
# ------------------------------------------------------------------------------
# Maximum order value permitted for Cash on Delivery (COD) in INR
MAX_COD_ORDER_VALUE=2000

# Minimum cart subtotal required to qualify for Free Shipping in INR
FREE_SHIPPING_THRESHOLD=999

# Standard flat shipping fee applied if cart is below threshold
STANDARD_SHIPPING_FEE=70

# Jaipur Local Postal Code Range prefix (First 3 digits of Jaipur PIN codes: 302xxx)
JAIPUR_PINCODE_PREFIX=302

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & ERROR TRACKING (Sentry - Optional in Development)
# ------------------------------------------------------------------------------
# Sentry DSN for backend exception reporting (Leave empty to disable in local dev)
SENTRY_DSN=
